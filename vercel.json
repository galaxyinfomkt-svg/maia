{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/massachusetts/:city/:service",
      "destination": "/services/:service/:city/",
      "permanent": true
    },
    {
      "source": "/massachusetts/:city",
      "destination": "/cities/:city/",
      "permanent": true
    },
    {
      "source": "/massachusetts",
      "destination": "/cities/",
      "permanent": true
    }
  ]
}
